# Everything the app needs. Copy to .env and restart Metro (`npx expo start -c`).

# Particle Inference API — OpenAI-compatible.
# Global: https://api.particle.ai/v1 · US-only GPUs: https://us.api.particle.ai/v1
EXPO_PUBLIC_LLM_BASE_URL=https://api.particle.ai/v1

# From platform.particle.ai → API keys. Shown once at creation.
EXPO_PUBLIC_LLM_API_KEY=pai-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# particle-1 · deepseek-ai/deepseek-v41-flash-1017 · z-ai/glm-5.3-flash
EXPO_PUBLIC_LLM_MODEL=particle-1

# none | low | medium | high. "none" = fastest, no thinking tokens (GLM rejects it).
EXPO_PUBLIC_LLM_REASONING_EFFORT=none

# Cap per reply. Tool calls need ~60; consequence lines ~40.
EXPO_PUBLIC_LLM_MAX_TOKENS=200

# 1 = show the SIM WAVE/HOLD/×2 row (touchless fallback for a stage with no sensor).
# 0 = gestures only, which is the point.
EXPO_PUBLIC_DEBUG_GESTURES=0
