# ── secrets ───────────────────────────────────────────────────────────────
# .env holds the particle.ai key and the GitHub token. It is never committed
# and never zipped; .env.example ships placeholders instead.
.env
.env.*
!.env.example
*.pem
*.key
*.p8
*.p12
*.jks
*.mobileprovision

# ── dependencies ──────────────────────────────────────────────────────────
node_modules/
.pnp
.pnp.js
.yarn/
jspm_packages/

# ── Expo / Metro build output ─────────────────────────────────────────────
.expo/
.expo-shared/
dist/
web-build/
build/
expo-env.d.ts
.metro-health-check*
*.tsbuildinfo

# generated native folders (regenerate with `npx expo prebuild`)
/ios
/android
.kotlin/

# ── test + tool output ────────────────────────────────────────────────────
coverage/
*.lcov
test-results/
playwright-report/
*.log
npm-debug.*
yarn-debug.*
yarn-error.*

# ── local scratch ─────────────────────────────────────────────────────────
.tmp/
tmp/
*.zip
*.mp4
*.mov
*.wav.bak

# ── writing + screenshots that stay on this machine ───────────────────────
# blog and launch copy are written for publishing elsewhere, not for the repo
docs/blog.md
docs/launch.md
shots/

# ── editors + agents ──────────────────────────────────────────────────────
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
.claude/
